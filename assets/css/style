*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, Helvetica, sans-serif;
    scroll-behavior: smooth;
}
body{
    background: black;
}

/* ===============================
   NAVBAR 
================================== */
nav{
    width: 100%;
    background: black;
    padding: 25px 40px; 
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 1000;
    /* Ini pengganti efek JS: Garis batas tipis permanen di bawah navbar */
    border-bottom: 1px solid rgba(255, 255, 255, 0.1); 
}
.logo{
    color: white;
    font-size: 26px; 
    font-weight: bold;
    letter-spacing: 1px;
}
nav ul{
    display: flex;
    list-style: none;
    gap: 20px; 
    align-items: center;
}
nav ul li a{
    color: white;
    text-decoration: none;
    font-size: 17px; 
    font-weight: bold;
    transition: 0.3s;
}
nav ul li a:hover{
    color: #ccc;
}


/* ===============================
   HERO SECTION
================================== */
.hero{
    width: 100%;
    height: 100vh;
    background: linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)), url('../img/hero.jpg');
    background-size: cover;
    background-position: center;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
}
.hero-content{
    color: white;
    margin-top: 350px;
}
.hero-content h1{
    font-size: 70px;
    margin-bottom: 20px;
}
.hero-content p{
    font-size: 28px;
    margin-bottom: 30px;
}
.hero-btn{
    display: inline-block;
    padding: 15px 35px;
    background: black;
    color: white;
    border: 1px solid white;
    text-decoration: none;
    border-radius: 5px;
    font-size: 18px;
    transition: 0.3s;
}
.hero-btn:hover{
    background: white;
    color: black;
}


/* ===============================
   ABOUT SECTION
================================== */
.about{
    padding: 100px 80px;
    display: flex;
    align-items: center;
    gap: 60px;
    background: black; 
    color: white; 
}
.about-image img{
    width: 500px;
    border-radius: 15px;
}
.about-text h2{
    font-size: 50px;
    margin-bottom: 20px;
}
.about-text p{
    font-size: 22px;
    line-height: 1.8;
    color: #ddd; 
}
.about-btn {
    display: inline-block;
    margin-top: 25px;
    padding: 12px 30px;
    background: black;
    color: white;
    border: 1px solid white;
    text-decoration: none;
    border-radius: 5px;
    font-size: 18px;
    font-weight: bold;
    transition: background 0.3s ease, color 0.3s ease;
}
.about-btn:hover {
    background: white; 
    color: black;
}


/* ===============================
   PRODUCT 
================================== */
.product{
    padding: 100px 80px;
}
.product-title{
    text-align: center;
    font-size: 45px;
    margin-bottom: 50px;
    color: white;
}
.product-container{
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
}
.product-card{
    width: 310px;
    background: white; 
    color: black;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 15px rgba(255,255,255,0.1);
    display: flex;
    flex-direction: column;
}
.product-card img{
    width: 100%;
    height: 400px;
    object-fit: cover;
}
.product-info{
    padding: 25px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}
.product-info h3{
    font-size: 24px;
    margin-bottom: 10px;
}
.product-info p{
    font-size: 16px;
    margin-bottom: 15px;
    color: #666;
}
.price{
    font-size: 26px;
    font-weight: bold;
    margin-bottom: 20px;
}
.buy-btn{
    padding: 12px 25px;
    background: black;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 18px;
    margin-top: auto;
    text-align: center; 
    text-decoration: none; 
    display: block;
}


/* ===============================
   TESTIMONIAL 
================================== */
.testimonial{
    padding: 100px 80px;
    background: black; 
}
.testimonial-title{
    text-align: center;
    font-size: 45px;
    margin-bottom: 50px;
    color: white; 
}
.testimonial-container{
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
}
.testimonial-card{
    width: 350px;
    background: #f5f5f5; 
    color: black;
    padding: 30px;
    border-radius: 15px;
}
.testimonial-card h3{
    font-size: 28px;
    margin-bottom: 15px;
}
.testimonial-card p{
    font-size: 18px;
    line-height: 1.7;
}


/* ===============================
   FOOTER 
================================== */
footer{
    background: black;
    color: white;
    text-align: center;
    padding: 30px;
    font-size: 18px;
}


/* ===============================
   PRODUCT DETAIL PAGE 
================================== */
.bg-white {
    background: white; 
}
.product-detail, .cart-page {
    padding: 100px 80px;
    color: black;
    min-height: 80vh;
}
.detail-container {
    display: flex;
    gap: 60px;
    max-width: 1100px; 
    margin: 0 auto;
}
.detail-left {
    flex: 1;
    display: flex;
    flex-direction: column;
}
.detail-left img.main-image {
    width: 100%;
    border-radius: 10px;
    object-fit: cover;
}
.detail-right {
    flex: 1;
    padding-top: 20px;
}
.detail-right h2 {
    font-size: 28px;
    margin-bottom: 20px;
    text-transform: uppercase;
}
.detail-price {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 40px;
}

/* KOTAK UKURAN (SIZE GRID) */
.size-selection {
    margin-bottom: 30px;
}
.size-label {
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 15px;
    display: block;
    color: #0b1a45; 
}
.size-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
}
.size-grid input[type="radio"] {
    display: none !important; 
}
.size-box {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 55px;
    height: 55px;
    border: 1px solid #ccc;
    border-radius: 4px;
    cursor: pointer;
    font-size: 18px;
    color: #0b1a45;
    background: white;
    transition: all 0.2s ease;
}
.size-box:hover {
    border-color: #0b1a45;
}
.size-grid input[type="radio"]:checked + .size-box {
    border: 2px solid #0b1a45;
    font-weight: bold;
    background: #f0f4f8; 
}

.add-to-cart-btn {
    padding: 15px 40px;
    background: black;
    color: white;
    border: none;
    border-radius: 5px;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    width: 100%;
    max-width: 400px;
    transition: background 0.3s ease;
}
.add-to-cart-btn:hover {
    background: #333;
}


/* ===============================
   CART PAGE 
================================== */
.cart-container {
    max-width: 800px; 
    margin: 0 auto;
}
.cart-container h2 {
    margin-bottom: 20px;
    border-bottom: 2px solid black;
    padding-bottom: 10px;
}
.cart-item {
    display: flex; 
    justify-content: space-between; 
    align-items: center;
    border-bottom: 1px solid #ccc; 
    padding-bottom: 20px; 
    margin-top: 30px;
}
.cart-item-info h3 {
    margin-bottom: 10px;
}
.checkout-btn {
    display: block; 
    width: 100%; 
    text-align: center; 
    background: black; 
    color: white; 
    padding: 15px; 
    margin-top: 30px; 
    text-decoration: none; 
    border-radius: 5px; 
    font-weight: bold; 
    transition: 0.3s;
}
.checkout-btn:hover {
    background: #333;
}
