<?php
class ProductModel {
    private $conn;
    public function __construct($db) {
        $this->conn = $db;
    }
    public function readAll() {
        return $this->conn->query("SELECT * FROM products ORDER BY created_at DESC");
    }
    public function readOne($id) {
        $stmt = $this->conn->prepare("SELECT * FROM products WHERE id = ?");
        $stmt->execute([$id]);
        return $stmt->fetch(PDO::FETCH_ASSOC);
    }
    public function create($id, $name, $cat, $price, $img, $shp) {
        $stmt = $this->conn->prepare("
            INSERT INTO products
            (id,name,category,price,image,shopee)
            VALUES (?,?,?,?,?,?)
        ");
        return $stmt->execute([
            $id,
            $name,
            $cat,
            $price,
            $img,
            $shp
        ]);
    }
    public function update($id, $name, $cat, $price, $img, $shp) {
        $stmt = $this->conn->prepare("
            UPDATE products
            SET
                name=?,
                category=?,
                price=?,
                image=?,
                shopee=?
            WHERE id=?
        ");
        return $stmt->execute([
            $name,
            $cat,
            $price,
            $img,
            $shp,
            $id
        ]);
    }
    public function delete($id) {
        $stmtImg = $this->conn->prepare(
            "SELECT image FROM products WHERE id=?"
        );
        $stmtImg->execute([$id]);
        $data = $stmtImg->fetch(PDO::FETCH_ASSOC);
        if($data){
            $imagePath = __DIR__ . '/../' . $data['image'];
            if(file_exists($imagePath)){
                unlink($imagePath);
            }
            $stmt = $this->conn->prepare(
                "DELETE FROM products WHERE id=?"
            );
            return $stmt->execute([$id]);
        }
        return false;
    }
    public function addTestimonial($name, $review, $rating) {
        $stmt = $this->conn->prepare("
            INSERT INTO testimonials
            (customer_name,review,rating)
            VALUES (?,?,?)
        ");
        return $stmt->execute([
            $name,
            $review,
            $rating
        ]);
    }
    public function readTestimonials() {
        return $this->conn->query("SELECT * FROM testimonials ORDER BY id DESC");
    }
    public function deleteTestimonial($id) {
        $stmt = $this->conn->prepare("DELETE FROM testimonials WHERE id = ?");
        return $stmt->execute([$id]);
    }
}
?>
