<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Access - AETHER COLLECTIVE</title>
    <link rel="stylesheet" href="assets/css/style.css"> 
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            
            background-image: url('assets/img/hero.jpg'); 
            background-size: cover;
            background-position: center;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .login-overlay {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.75); /* Memberi efek gelap elegan */
        }
        .login-box {
            position: relative;
            z-index: 1;
            background: rgba(20, 20, 20, 0.6);
            padding: 50px 40px;
            border-radius: 12px;
            text-align: center;
            border: 1px solid rgba(255,255,255,0.1);
            box-shadow: 0 15px 30px rgba(0,0,0,0.8);
            width: 320px;
            backdrop-filter: blur(8px); /* Efek kaca blur */
        }
        .login-box h2 {
            color: white;
            margin-bottom: 30px;
            font-size: 24px;
            letter-spacing: 3px;
            font-weight: 400;
        }
        .input-group {
            margin-bottom: 20px;
        }
        .input-group input {
            width: 100%;
            padding: 12px 15px;
            background: rgba(0, 0, 0, 0.5);
            border: 1px solid #444;
            color: white;
            border-radius: 5px;
            box-sizing: border-box;
            font-size: 14px;
            transition: 0.3s;
        }
        .input-group input:focus {
            outline: none;
            border-color: #fff;
            background: rgba(0, 0, 0, 0.8);
        }
        .login-btn {
            width: 100%;
            padding: 14px;
            background: white;
            color: black;
            border: none;
            font-weight: bold;
            letter-spacing: 2px;
            border-radius: 5px;
            cursor: pointer;
            transition: 0.3s;
            margin-top: 10px;
        }
        .login-btn:hover {
            background: #aaa;
        }
        .back-link {
            display: inline-block;
            margin-top: 25px;
            color: #777;
            text-decoration: none;
            font-size: 12px;
            letter-spacing: 1px;
            transition: 0.3s;
        }
        .back-link:hover {
            color: white;
        }
    </style>
</head>
<body>
    
    <div class="login-overlay"></div>
    
    <div class="login-box">
        <h2>AETHER ADMIN</h2>
        <form action="admin.php?action=login" method="POST">
            <div class="input-group">
                <input type="text" name="username" placeholder="Username" required autocomplete="off">
            </div>
            <div class="input-group">
                <input type="password" name="password" placeholder="Password" required>
            </div>
            <button type="submit" class="login-btn">LOGIN</button>
        </form>
        <a href="index.php" class="back-link">← RETURN TO STORE</a>
    </div>

</body>
</html>
